  "services": {
    "start_regeneration": {
      "name": "Start regeneration",
      "description": "Starts a regeneration cycle on the water system. A regeneration uses water and salt and cannot be cancelled once it begins.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The water system to regenerate."
        },
        "when": {
          "name": "When",
          "description": "Start the cycle immediately, or queue it for the next scheduled regeneration time."
        }
      }
    },
    "find_home": {
      "name": "Find home",
      "description": "Tells the valve to locate its home position. Useful after a 'Lost Home' or 'Can't Find Home' error.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The water system to command."
        }
      }
    },
    "set_salt_level": {
      "name": "Set salt level",
      "description": "Records how much salt is in the brine tank, for example after refilling it.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The water system to update."
        },
        "pounds": {
          "name": "Salt",
          "description": "Pounds of salt currently in the brine tank."
        }
      }
    },
    "reset_counters": {
      "name": "Reset counters",
      "description": "Zeroes the resettable regeneration and gallon counters. Lifetime totals are not affected.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The water system to update."
        },
        "counters": {
          "name": "Counters",
          "description": "Which resettable counters to zero."
        }
      }
    },
    "sync_clock": {
      "name": "Sync clock",
      "description": "Sets the valve's clock to match Home Assistant's local time. The valve schedules regenerations against its own clock, so drift shifts when they run.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The water system to update."
        }
      }
    },
    "probe_write_framing": {
      "name": "Probe write framing (diagnostic)",
      "description": "Temporary diagnostic. Writes the current seconds under each candidate checksum convention and reports which the valve accepts.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The water system to probe."
        }
      }
    }
